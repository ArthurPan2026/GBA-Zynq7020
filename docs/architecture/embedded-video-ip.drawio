        </mxCell>
        <mxCell id="side-scope" value="本轮不增加用户功能&#xa;不加 FRL / Deep Color / YCbCr&#xa;不加 HDCP / CEC 协议 / ARC / HEAC&#xa;不加分辨率或音频格式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
