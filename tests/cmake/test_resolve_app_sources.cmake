cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED RESOLVER_FILE OR NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_SCENARIO)
    message(FATAL_ERROR "RESOLVER_FILE, TEST_ROOT, and TEST_SCENARIO are required")
endif()
include("${RESOLVER_FILE}")
file(MAKE_DIRECTORY "${TEST_ROOT}")

if(TEST_SCENARIO STREQUAL "nested")
    file(MAKE_DIRECTORY "${TEST_ROOT}/Hdmi/Src")
    file(WRITE "${TEST_ROOT}/Hdmi/Src/ps_app_hdmi_link.c" "/* fixture */")
    set(_app_source_index "${TEST_ROOT}/Hdmi/Src/ps_app_hdmi_link.c")
    set(_collector_sources "ps_app_hdmi_link.c")
    zynq_gba_resolve_app_sources(app_sources "${TEST_ROOT}" _app_source_index _collector_sources)
    file(RELATIVE_PATH _resolved "${TEST_ROOT}" "${app_sources}")
    if(NOT _resolved STREQUAL "Hdmi/Src/ps_app_hdmi_link.c")
        message(FATAL_ERROR "Nested HDMI source resolved incorrectly: ${_resolved}")
    endif()
elseif(TEST_SCENARIO STREQUAL "exact_path")
    file(MAKE_DIRECTORY "${TEST_ROOT}/A" "${TEST_ROOT}/B")
    file(WRITE "${TEST_ROOT}/A/ps_app_diag.c" "/* fixture */")
    file(WRITE "${TEST_ROOT}/B/ps_app_diag.c" "/* fixture */")
    set(_app_source_index "${TEST_ROOT}/A/ps_app_diag.c" "${TEST_ROOT}/B/ps_app_diag.c")
    set(_collector_sources "A/ps_app_diag.c")
    zynq_gba_resolve_app_sources(app_sources "${TEST_ROOT}" _app_source_index _collector_sources)
    file(RELATIVE_PATH _resolved "${TEST_ROOT}" "${app_sources}")
    if(NOT _resolved STREQUAL "A/ps_app_diag.c")
        message(FATAL_ERROR "Exact source path did not take precedence: ${_resolved}")
    endif()
elseif(TEST_SCENARIO STREQUAL "ambiguous")
    file(MAKE_DIRECTORY "${TEST_ROOT}/A" "${TEST_ROOT}/B")
    file(WRITE "${TEST_ROOT}/A/duplicate.c" "/* fixture */")
    file(WRITE "${TEST_ROOT}/B/duplicate.c" "/* fixture */")
    set(_app_source_index "${TEST_ROOT}/A/duplicate.c" "${TEST_ROOT}/B/duplicate.c")
    set(_collector_sources "duplicate.c")
    zynq_gba_resolve_app_sources(app_sources "${TEST_ROOT}" _app_source_index _collector_sources)
elseif(TEST_SCENARIO STREQUAL "missing")
    file(WRITE "${TEST_ROOT}/other.c" "/* fixture */")
    set(_app_source_index "${TEST_ROOT}/other.c")
    set(_collector_sources "missing.c")
    zynq_gba_resolve_app_sources(app_sources "${TEST_ROOT}" _app_source_index _collector_sources)
elseif(TEST_SCENARIO STREQUAL "empty")
    file(WRITE "${TEST_ROOT}/available.c" "/* fixture */")
    set(_app_source_index "${TEST_ROOT}/available.c")
    set(_collector_sources "")
    set(_user_sources "")
    zynq_gba_resolve_app_sources(app_sources "${TEST_ROOT}" _app_source_index _collector_sources _user_sources)
elseif(TEST_SCENARIO STREQUAL "lvgl_disabled" OR TEST_SCENARIO STREQUAL "lvgl_enabled")
    file(MAKE_DIRECTORY
        "${TEST_ROOT}/ThirdParty/lvgl/src/libs/vg_lite_driver/VGLite"
        "${TEST_ROOT}/ThirdParty/lvgl/src/debugging/vg_lite_tvg"
        "${TEST_ROOT}/ThirdParty/lvgl/src/core")
    file(WRITE "${TEST_ROOT}/ThirdParty/lvgl/src/libs/vg_lite_driver/VGLite/vg_lite_matrix.c" "/* fixture */")
    file(WRITE "${TEST_ROOT}/ThirdParty/lvgl/src/debugging/vg_lite_tvg/vg_lite_matrix.c" "/* fixture */")
    file(WRITE "${TEST_ROOT}/ThirdParty/lvgl/src/core/lv_obj.c" "/* fixture */")
    set(_app_source_index
        "${TEST_ROOT}/ThirdParty/lvgl/src/libs/vg_lite_driver/VGLite/vg_lite_matrix.c"
        "${TEST_ROOT}/ThirdParty/lvgl/src/debugging/vg_lite_tvg/vg_lite_matrix.c"
        "${TEST_ROOT}/ThirdParty/lvgl/src/core/lv_obj.c")
    if(TEST_SCENARIO STREQUAL "lvgl_disabled")
        set(_driver 0)
    else()
        set(_driver 1)
    endif()
    file(WRITE "${TEST_ROOT}/lv_conf.h"
        "#define LV_USE_DRAW_VG_LITE 0\n#define LV_USE_VG_LITE_DRIVER ${_driver}\n#define LV_USE_VG_LITE_THORVG 0\n")
    set(_collector_sources "vg_lite_matrix.c" "lv_obj.c")
    zynq_gba_filter_disabled_vglite_collision(_selected_sources "${TEST_ROOT}/lv_conf.h" _collector_sources)
    zynq_gba_resolve_app_sources(_resolved_sources "${TEST_ROOT}" _app_source_index _selected_sources)
    if(TEST_SCENARIO STREQUAL "lvgl_disabled")
        file(RELATIVE_PATH _resolved "${TEST_ROOT}" "${_resolved_sources}")
        if(NOT _resolved STREQUAL "ThirdParty/lvgl/src/core/lv_obj.c")
            message(FATAL_ERROR "Disabled VGLite collision was not filtered: ${_resolved}")
        endif()
    endif()
else()
    message(FATAL_ERROR "Unknown TEST_SCENARIO: ${TEST_SCENARIO}")
endif()
