# Keep text assets stable across Windows and Linux workstations.
*.py text eol=lf
*.tcl text eol=lf
*.cmake text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.pdf binary
*.bit binary
*.bin binary
*.xsa binary
# Preserve the vendored Digilent source package byte-for-byte.
*.docx binary

# Project source and Vivado text stay LF in Windows and Linux worktrees.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.S text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.sv text eol=lf
*.vhd text eol=lf
*.xdc text eol=lf
*.xci text eol=lf
*.bd text eol=lf
*.bda text eol=lf
*.xpr text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.mem text eol=lf
*.hex text eol=lf
*.txt text eol=lf
*.ld text eol=lf
LICENSE text eol=lf
LICENSE.* text eol=lf

# Preserve archived build logs, reports, binaries and captures byte-for-byte.
artifacts/** -text -diff
docs/archive/rom-progress/** -text -diff
