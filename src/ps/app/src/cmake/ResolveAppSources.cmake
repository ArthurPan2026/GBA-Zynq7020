function(zynq_gba_resolve_app_sources output_var source_root source_index_var)
    if(NOT DEFINED ${source_index_var})
        message(FATAL_ERROR "Source index variable is undefined: ${source_index_var}")
    endif()
    get_filename_component(_source_root "${source_root}" REALPATH)
    set(_resolved_sources)
    foreach(_source_list_var IN LISTS ARGN)
        if(NOT DEFINED ${_source_list_var})
            message(FATAL_ERROR "Vitis source list variable is undefined: ${_source_list_var}")
        endif()
        foreach(_requested IN LISTS ${_source_list_var})
            if(_requested STREQUAL "")
                continue()
            endif()
            if(IS_ABSOLUTE "${_requested}")
                set(_candidate "${_requested}")
            else()
                set(_candidate "${_source_root}/${_requested}")
            endif()
            get_filename_component(_candidate "${_candidate}" ABSOLUTE)
            if(EXISTS "${_candidate}" AND NOT IS_DIRECTORY "${_candidate}")
                get_filename_component(_canonical_candidate "${_candidate}" REALPATH)
                file(RELATIVE_PATH _relative_candidate "${_source_root}" "${_canonical_candidate}")
                string(FIND "${_relative_candidate}" "../" _parent_prefix)
                if(IS_ABSOLUTE "${_relative_candidate}" OR _relative_candidate STREQUAL ".." OR _parent_prefix EQUAL 0)
                    message(FATAL_ERROR "Vitis source entry resolves outside the staged source tree: ${_requested}")
                endif()
                list(APPEND _resolved_sources "${_canonical_candidate}")
                continue()
            endif()
            get_filename_component(_basename "${_requested}" NAME)
            if(_basename STREQUAL "")
                message(FATAL_ERROR "Vitis source entry has no file name: ${_requested}")
            endif()
            set(_matches)
            foreach(_indexed_source IN LISTS ${source_index_var})
                if(EXISTS "${_indexed_source}" AND NOT IS_DIRECTORY "${_indexed_source}")
                    get_filename_component(_canonical_indexed_source "${_indexed_source}" REALPATH)
                    file(RELATIVE_PATH _relative_indexed_source "${_source_root}" "${_canonical_indexed_source}")
                    string(FIND "${_relative_indexed_source}" "../" _indexed_parent_prefix)
                    if(NOT IS_ABSOLUTE "${_relative_indexed_source}" AND NOT _relative_indexed_source STREQUAL ".." AND NOT _indexed_parent_prefix EQUAL 0)
                        get_filename_component(_indexed_basename "${_canonical_indexed_source}" NAME)
                        if(_indexed_basename STREQUAL _basename)
                            list(APPEND _matches "${_canonical_indexed_source}")
                        endif()
                    endif()
                endif()
            endforeach()
            list(REMOVE_DUPLICATES _matches)
            list(LENGTH _matches _match_count)
            if(_match_count EQUAL 0)
                message(FATAL_ERROR "Vitis source entry ${_requested} matched no staged source under ${_source_root}")
            elseif(_match_count GREATER 1)
                list(JOIN _matches ", " _match_description)
                message(FATAL_ERROR "Vitis source entry ${_requested} is ambiguous by basename: ${_match_description}")
            endif()
            list(APPEND _resolved_sources ${_matches})
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _resolved_sources)
    if(NOT _resolved_sources)
        message(FATAL_ERROR "No Vitis app source entries were selected from the collector or UserConfig.cmake")
    endif()
    set(${output_var} "${_resolved_sources}" PARENT_SCOPE)
endfunction()

# Drop the one known flattened-name collision while its LVGL providers are disabled.
# Any VGLite enablement requires explicit pathful source entries and fails here.
function(zynq_gba_filter_disabled_vglite_collision output_var config_file)
    if(NOT EXISTS "${config_file}")
        message(FATAL_ERROR "LVGL config not found: ${config_file}")
    endif()

    set(_vglite_enabled FALSE)
    foreach(_feature IN ITEMS
        LV_USE_DRAW_VG_LITE
        LV_USE_VG_LITE_DRIVER
        LV_USE_VG_LITE_THORVG)
        file(STRINGS "${config_file}" _definitions REGEX "^#define ${_feature} [01]$")
        list(LENGTH _definitions _definition_count)
        if(NOT _definition_count EQUAL 1)
            message(FATAL_ERROR "${_feature} must have one explicit 0/1 definition in ${config_file}")
        endif()
        if(_definitions MATCHES " 1$")
            set(_vglite_enabled TRUE)
        endif()
    endforeach()

    if(_vglite_enabled)
        message(FATAL_ERROR "LVGL VGLite is enabled, but the Vitis collector flattens vg_lite_matrix.c; add explicit source paths before enabling VGLite")
    endif()

    set(_filtered_sources)
    foreach(_source_list_var IN LISTS ARGN)
        if(NOT DEFINED ${_source_list_var})
            message(FATAL_ERROR "Vitis source list variable is undefined: ${_source_list_var}")
        endif()
        foreach(_source IN LISTS ${_source_list_var})
            get_filename_component(_basename "${_source}" NAME)
            if(_basename STREQUAL "vg_lite_matrix.c")
                continue()
            endif()
            list(APPEND _filtered_sources "${_source}")
        endforeach()
    endforeach()

    list(REMOVE_DUPLICATES _filtered_sources)
    set(${output_var} "${_filtered_sources}" PARENT_SCOPE)
endfunction()
